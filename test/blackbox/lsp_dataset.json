    {
      "id": "SYS-005",
      "category": "System",
      "name": "Unknown notification silently ignored",
      "messages": [
        {"method": "initialize", "id": 1, "params": {"processId": null, "rootUri": "file:///tmp/lsp_test", "capabilities": {}}},
