{
  "system": "Vaisto LSP Server",
  "version": "0.1.0",
  "protocol": "JSON-RPC 2.0 (Language Server Protocol)",
  "contract_sources": {
    "LSP_3_17": "https://microsoft.github.io/language-server-protocol/specifications/lsp/3.17/specification/",
    "JSON_RPC_2_0": "https://www.jsonrpc.org/specification",
    "README": "README.md#Editor-support-(VS-Code) — advertises hover, diagnostics, symbols",
    "CLAUDE": "CLAUDE.md (architecture reference; type checker behavior backs diagnostics)"
  },
  "annotation_notes": "Every case carries a spec_source field naming the contract anchor it derives from. Cases without a clear source carry spec_source: null and a needs_triage note — those should either get a Vaisto-side spec written or be deleted as code-derived.",
  "test_cases": [
    {
      "id": "POS-001",
      "category": "Positive",
      "name": "Initialize handshake",
      "messages": [
        {"method": "initialize", "id": 1, "params": {"processId": null, "rootUri": "file:///tmp/lsp_test", "capabilities": {}}}
      ],
      "expect_response_id": 1,
      "expect_result_keys": ["capabilities", "serverInfo"],
      "expect_capability": "hoverProvider",
      "spec_source": "LSP 3.17 §initialize (response must include `capabilities` and `serverInfo`)"
    },
    {
      "id": "POS-002",
      "category": "Positive",
      "name": "Shutdown returns null",
      "messages": [
        {"method": "initialize", "id": 1, "params": {"processId": null, "rootUri": "file:///tmp/lsp_test", "capabilities": {}}},
        {"method": "initialized", "params": {}},
        {"method": "shutdown", "id": 2, "params": null}
      ],
      "expect_response_id": 2,
      "expect_result": null,
      "spec_source": "LSP 3.17 §shutdown (`The result returned is null`)"
    },
    {
      "id": "POS-003",
      "category": "Positive",
      "name": "didOpen valid file → no diagnostics",
      "messages": [
        {"method": "initialize", "id": 1, "params": {"processId": null, "rootUri": "file:///tmp/lsp_test", "capabilities": {}}},
        {"method": "initialized", "params": {}},
        {"method": "textDocument/didOpen", "params": {"textDocument": {"uri": "file:///tmp/test.va", "languageId": "vaisto", "version": 1, "text": "(defn add [x :int y :int] :int (+ x y))"}}}
      ],
      "expect_notification": "textDocument/publishDiagnostics",
      "expect_diagnostics_count": 0,
      "spec_source": "LSP 3.17 §textDocument_didOpen + §textDocument_publishDiagnostics — server publishes diagnostics on open; valid document → empty diagnostics array"
    },
    {
      "id": "POS-004",
      "category": "Positive",
      "name": "didOpen invalid file → error diagnostics",
      "messages": [
        {"method": "initialize", "id": 1, "params": {"processId": null, "rootUri": "file:///tmp/lsp_test", "capabilities": {}}},
        {"method": "initialized", "params": {}},
        {"method": "textDocument/didOpen", "params": {"textDocument": {"uri": "file:///tmp/bad.va", "languageId": "vaisto", "version": 1, "text": "(defn broken [x :int] :string x)"}}}
      ],
      "expect_notification": "textDocument/publishDiagnostics",
      "expect_diagnostics_min": 1,
      "spec_source": "LSP 3.17 §textDocument_publishDiagnostics + CLAUDE.md#Structured-Error-System — type mismatch between declared `:string` return and `:int` body must surface as a diagnostic"
    },
    {
      "id": "POS-005",
      "category": "Positive",
      "name": "didOpen parse error → diagnostics",
      "messages": [
        {"method": "initialize", "id": 1, "params": {"processId": null, "rootUri": "file:///tmp/lsp_test", "capabilities": {}}},
        {"method": "initialized", "params": {}},
        {"method": "textDocument/didOpen", "params": {"textDocument": {"uri": "file:///tmp/parse_err.va", "languageId": "vaisto", "version": 1, "text": "(defn oops [x"}}}
      ],
      "expect_notification": "textDocument/publishDiagnostics",
      "expect_diagnostics_min": 1,
      "spec_source": "LSP 3.17 §textDocument_publishDiagnostics + CLAUDE.md#Error-Handling — Parser raises on syntax errors; LSP must catch and surface as diagnostics"
    },
    {
      "id": "POS-006",
      "category": "Positive",
      "name": "didClose clears diagnostics",
      "messages": [
        {"method": "initialize", "id": 1, "params": {"processId": null, "rootUri": "file:///tmp/lsp_test", "capabilities": {}}},
        {"method": "initialized", "params": {}},
        {"method": "textDocument/didOpen", "params": {"textDocument": {"uri": "file:///tmp/close.va", "languageId": "vaisto", "version": 1, "text": "(defn add [x :int y :int] :int (+ x y))"}}},
        {"method": "textDocument/didClose", "params": {"textDocument": {"uri": "file:///tmp/close.va"}}}
      ],
      "expect_notification": "textDocument/publishDiagnostics",
      "expect_diagnostics_count": 0,
      "expect_notification_uri": "file:///tmp/close.va",
      "spec_source": "LSP 3.17 §textDocument_didClose (`a server should clear them by sending an empty array`)"
    },
