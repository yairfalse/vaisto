; Std.Map - Typed finite-map helpers. Option is supplied by the prelude.
(ns Std.Map)

; Safe get with default value
(defn get-or [m (Map :k :v) key :k default :v] :v
  (if (map-has? m key)
    (map-get m key)
    default))

; Safe get returning Option
(defn lookup [m (Map :k :v) key :k] (Option :v)
  (if (map-has? m key)
    (Some (map-get m key))
    (None)))

; Update a value with a function, or insert default if missing
(defn update [m (Map :k :v) key :k default :v f (Fn :v :v :effects :e)] (Map :k :v) :effects :e
  (if (map-has? m key)
    (map-put m key (f (map-get m key)))
    (map-put m key default)))
