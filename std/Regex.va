; Vaisto Regex Module
; Provides regular expression support using Erlang's :re module
;
; Essential for lexing/tokenizing source code in self-hosted compiler

(ns Std.Regex)

; --- Erlang FFI ---

; Binary operations and checked foreign boundaries
(extern erlang/byte_size [:binary] :int)

; Binary operations
(extern binary/part [:binary :int :int] :binary)

; Compile a regex pattern (returns {:ok, MP} or {:error, reason})
(extern re/compile [:string] (Core.TaskResult :dyn))

; Run compiled regex against string
; Returns {:match, Captured} or :nomatch
(extern re/run [:string :dyn] :dyn)

; Run with options (for captures, global matching, etc.)
(extern re/run [:string :dyn (List :dyn)] :dyn)

; Replace matches in string
(extern re/replace [:string :dyn :string (List :dyn)] :string)

; Replace all matches
; Split string by regex
(extern re/split [:string :dyn (List :dyn)] (List :string))

; Validate both the tag and the complete capture shape before using it.
(defn binary-captures [string :string pattern :dyn options (List :dyn)] (Option (List :string))
  (let [raw (re/run string pattern options)]
    (match (decode :atom raw)
      [(Core.Ok :nomatch) (None)]
      [_ (match (decode (Tuple :atom (List :string)) raw)
        [(Core.Ok {:match captures}) (Some captures)]
        [_ (crash :bad_decode)])])))

(defn index-captures [string :string pattern :dyn options (List :dyn)] (Option (List (Tuple :int :int)))
  (let [raw (re/run string pattern options)]
    (match (decode :atom raw)
      [(Core.Ok :nomatch) (None)]
      [_ (match (decode (Tuple :atom (List (Tuple :int :int))) raw)
        [(Core.Ok {:match captures}) (Some captures)]
        [_ (crash :bad_decode)])])))

(defn global-captures [string :string pattern :dyn] (List (List :string))
  (let [raw (re/run string pattern
    (list (up :atom :global) (up (Tuple :atom :atom :atom) {:capture :first :binary})))]
    (match (decode :atom raw)
      [(Core.Ok :nomatch) []]
      [_ (match (decode (Tuple :atom (List (List :string))) raw)
        [(Core.Ok {:match captures}) captures]
        [_ (crash :bad_decode)])])))

; --- High-level API ---

; Compile a regex pattern
; (compile "\\d+") -> (Ok compiled) | (Err reason)
(defn compile [pattern :string] (Result :dyn :dyn)
  (match (re/compile pattern)
    [{:ok mp} (Ok mp)]
    [{:error reason} (Err reason)]))

; Test if string matches pattern (returns bool)
; (matches? "hello123" "\\d+") -> true
(defn matches? [string :string pattern :dyn] :bool
  (match (index-captures string pattern [])
    [(Some _) true]
    [(None) false]))

; Find first match in string
; (find "hello123world" "\\d+") -> (Some "123") | None
(defn find [string :string pattern :dyn] (Option :string)
  (match (binary-captures string pattern (list (up (Tuple :atom :atom :atom) {:capture :first :binary})))
    [(Some captured) (Some (head captured))]
    [(None) (None)]))

; Find all matches in string
; (find-all "a1b2c3" "\\d") -> ["1" "2" "3"]
(defn find-all [string :string pattern :dyn] (List :string)
  (map (fn [x] (head x)) (global-captures string pattern)))

; Find match with position info
; (find-pos "hello123" "\\d+") -> (Some {:start 5 :len 3 :match "123"}) | None
(defn find-pos [string :string pattern :dyn] (Option (Record [start :int len :int match :string]))
  (match (index-captures string pattern (list (up (Tuple :atom :atom :atom) {:capture :first :index})))
    [(Some [{start len}])
      (Some #{ :start start
               :len len
               :match (binary/part string start len) })]
    [(None) (None)]
    [_ (crash :bad_decode)]))

; Replace first match
; (replace "hello123" "\\d+" "XXX") -> "helloXXX"
(defn replace [string :string pattern :dyn replacement :string] :string
  (re/replace string pattern replacement (list (up (Tuple :atom :atom) {:return :binary}))))

; Replace all matches
; (replace-all "a1b2c3" "\\d" "X") -> "aXbXcX"
(defn replace-all [string :string pattern :dyn replacement :string] :string
  (re/replace string pattern replacement
    (list (up :atom :global) (up (Tuple :atom :atom) {:return :binary}))))

; Split string by pattern
; (split "a,b,,c" ",") -> ["a" "b" "" "c"]
(defn split [string :string pattern :dyn] (List :string)
  (re/split string pattern (list (up (Tuple :atom :atom) {:return :binary}))))

; Split with limit
; (split-n "a,b,c,d" "," 2) -> ["a" "b,c,d"]
(defn split-n [string :string pattern :dyn n :int] (List :string)
  (re/split string pattern
    (list (up (Tuple :atom :atom) {:return :binary}) (up (Tuple :atom :int) {:parts n}))))

; --- Lexer helpers ---

; Match at start of string only (anchored)
; Useful for tokenizing: try each pattern until one matches at current position
; (match-at "123abc" "^\\d+") -> (Some {:match "123" :rest "abc"}) | None
(defn match-at [string :string pattern :dyn] (Option (Record [match :string rest :string]))
  (match (index-captures string pattern
      (list (up (Tuple :atom :atom :atom) {:capture :first :index}) (up :atom :anchored)))
    [(Some [{0 len}])
      (Some #{ :match (binary/part string 0 len)
               :rest (binary/part string len (- (erlang/byte_size string) len)) })]
    [(None) (None)]
    [_ (None)]))

; Match with capture groups at start of string
; Pattern should have parenthesized groups: "(\\d+)(\\w+)"
; Returns all captured groups plus the full match
;
; (match-groups "123abc rest" "(\\d+)(\\w+)")
;   -> (Some {:full "123abc"
;             :groups ["123" "abc"]
;             :rest " rest"})
(defn match-groups [string :string pattern :dyn] (Option (Record [full :string groups (List :string) rest :string]))
  (match (index-captures string pattern
      (list (up (Tuple :atom :atom :atom) {:capture :all :index}) (up :atom :anchored)))
    [(Some indices)
      (let [; First element is the full match
            {full-start full-len} (head indices)
            ; Rest are capture groups
            group-indices (tail indices)
            ; Extract the actual strings
            full-match (binary/part string full-start full-len)
            groups (map (fn [pair] (let [{start len} pair] (binary/part string start len))) group-indices)
            ; Calculate rest of string
            rest-start (+ full-start full-len)
            rest-len (- (erlang/byte_size string) rest-start)
            rest (binary/part string rest-start rest-len)]
        (Some #{ :full full-match
                 :groups groups
                 :rest rest }))]
    [(None) (None)]))

; Try multiple patterns in order, return first match
; (match-first "123abc" [{"number" "^\\d+"} {"ident" "^[a-z]+"}])
;   -> (Some {:type "number" :match "123" :rest "abc"})
(defn match-first [string :string patterns (List (Tuple :t :dyn))] (Option (Record [type :t match :string rest :string]))
  (match patterns
    [[] (None)]
    [[{type pattern} | rest]
      (match (match-at string pattern)
        [(Some m) (Some #{ :type type :match (. m :match) :rest (. m :rest) })]
        [(None) (match-first string rest)])]))

; Match first pattern with capture groups
; Each pattern is {type regex} where regex can have groups
; Returns {:type :full :groups :rest}
;
; (match-first-groups input
;   [{:string "\"([^\"]*)\""} {:number "(\\d+)"}])
(defn match-first-groups [string :string patterns (List (Tuple :t :dyn))] (Option (Record [type :t full :string groups (List :string) rest :string]))
  (match patterns
    [[] (None)]
    [[{type pattern} | rest]
      (match (match-groups string pattern)
        [(Some m) (Some #{ :type type
                           :full (. m :full)
                           :groups (. m :groups)
                           :rest (. m :rest) })]
        [(None) (match-first-groups string rest)])]))

; --- Position tracking for error messages ---

; Count newlines in a string (for line number tracking)
(defn count-newlines [string :string] :int
  (length (global-captures string (up :string "\n"))))

; Find column of last line (chars after last newline)
(defn last-line-length [string :string] :int
  (match (find-pos string (up :string "\n[^\n]*$"))
    [(Some m) (- (. m :len) 1)]  ; subtract the newline itself
    [(None) (erlang/byte_size string)]))

; Skip whitespace and track position changes
; Returns {:skipped :rest :lines :cols}
; where :lines is newlines crossed, :cols is column offset
(defn skip-whitespace [string :string] (Record [skipped :string rest :string lines :int cols :int])
  (match (match-at string (up :string "^[ \t\n\r]+"))
    [(Some m)
      (let [skipped (. m :match)
            lines (count-newlines skipped)
            cols (if (> lines 0)
                   (last-line-length skipped)
                   (erlang/byte_size skipped))]
        #{ :skipped skipped
           :rest (. m :rest)
           :lines lines
           :cols cols })]
    [(None)
      #{ :skipped ""
         :rest string
         :lines 0
         :cols 0 }]))

; --- Peek without consuming ---

; Look at next n characters without consuming
; (peek "hello" 3) -> "hel"
(defn peek [string :string n :int] :string
  (if (<= n (erlang/byte_size string))
    (binary/part string 0 n)
    string))

; Check if string starts with prefix
; (starts-with? "hello" "hel") -> true
(defn starts-with? [string :string prefix :string] :bool
  (== (peek string (erlang/byte_size prefix)) prefix))
