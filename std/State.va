; Process-local mutable state. Stored values and keys are explicitly Dyn;
; typed utilities decode the actual stored value before using it.
(ns Std.State)

(extern erlang/get [:dyn] :dyn)
(extern erlang/put [:dyn :dyn] :dyn)
(extern erlang/erase [:dyn] :dyn)
(extern erlang/get_keys [] (List :dyn))
(extern erlang/get [] (List (Tuple :dyn :dyn)))
(extern erlang/erase [] (List (Tuple :dyn :dyn)))
(extern erlang/binary_to_atom [:string] :atom)
(extern erlang/iolist_to_binary [(List :string)] :string)
(extern erlang/atom_to_binary [:atom] :string)
(extern erlang/integer_to_binary [:int] :string)
(extern lists/reverse [(List :dyn)] (List :dyn))
(extern erlang/element [:int :dyn] :dyn)

(defn get [key :dyn] (Option :dyn)
  (let [raw (erlang/get key)]
    (if (== raw (up :atom :undefined)) (None) (Some raw))))

(defn get-or [key :dyn default :dyn] :dyn
  (let [raw (erlang/get key)]
    (if (== raw (up :atom :undefined)) default raw)))

(defn set! [key :dyn value :dyn] (Option :dyn)
  (let [old (erlang/put key value)]
    (if (== old (up :atom :undefined)) (None) (Some old))))

(defn delete! [key :dyn] (Option :dyn)
  (let [old (erlang/erase key)]
    (if (== old (up :atom :undefined)) (None) (Some old))))

(defn has? [key :dyn] :bool
  (!= (erlang/get key) (up :atom :undefined)))

(defn update! [key :dyn f (Fn :dyn :dyn :effects (Effects [external] :fx))] :dyn :effects (Effects [external] :fx)
  (let [old (get-or key (up :atom :undefined))
        new (f old)]
    (set! key new)
    new))

; Generate prefix_0, prefix_1, ... without trusting a stored default as proof.
(defn unique-id [prefix :atom] :atom
  (let [key (up (Tuple :atom :atom) {:gensym prefix})]
    (match (decode :int (get-or key (up :int 0)))
      [(Core.Ok n)
        (set! key (up :int (+ n 1)))
        (erlang/binary_to_atom
          (erlang/iolist_to_binary
            (list (erlang/atom_to_binary prefix) "_" (erlang/integer_to_binary n))))]
      [(Core.Err _) (crash :bad_decode)])))

(defn counter-inc! [name :atom] :int
  (let [key (up :atom name)]
    (match (decode :int (get-or key (up :int 0)))
      [(Core.Ok n)
        (set! key (up :int (+ n 1)))
        (+ n 1)]
      [(Core.Err _) (crash :bad_decode)])))

(defn counter-reset! [name :atom] :int
  (set! (up :atom name) (up :int 0))
  0)

(defn accumulate! [key :dyn value :dyn] (Option :dyn)
  (match (decode (List :dyn) (get-or key (up (List :dyn) [])))
    [(Core.Ok current) (set! key (up (List :dyn) (cons value current)))]
    [(Core.Err _) (crash :bad_decode)]))

(defn get-accumulated [key :dyn] (List :dyn)
  (match (decode (List :dyn) (get-or key (up (List :dyn) [])))
    [(Core.Ok current) (lists/reverse current)]
    [(Core.Err _) (crash :bad_decode)]))

(defn clear-accumulated! [key :dyn] (List :dyn)
  (let [old (get-accumulated key)]
    (set! key (up (List :dyn) []))
    old))

; Arbitrary Erlang tuple projections remain a checked foreign boundary.
; Decode the returned Dyn before treating it as a concrete type.
(defn fst [tuple :dyn] :dyn (erlang/element 1 tuple))
(defn snd [tuple :dyn] :dyn (erlang/element 2 tuple))

(defn for-each [f (Fn :a :b :effects :fx) xs (List :a)] :atom :effects :fx
  (match xs
    [[] :ok]
    [[h | t] (f h) (for-each f t)]))

; State restoration is guaranteed on success and on a crash. The explicit
; external prefix covers storage; fx is the callback's remaining effects.
(defn with-isolated-state [f (Fn :a :effects (Effects [external] :fx))] :a :effects (Effects [external] :fx)
  (let [saved (erlang/get)]
    (try (f)
      [after (do
        (erlang/erase)
        (for-each (fn [entry]
          (let [{key value} entry] (erlang/put key value))) saved))])))

; Initial bindings are a list of {Dyn key, Dyn value} pairs.
(defn with-state [bindings (List (Tuple :dyn :dyn)) f (Fn :a :effects (Effects [external] :fx))] :a :effects (Effects [external] :fx)
  (with-isolated-state
    (the (Fn :a :effects (Effects [external] :fx))
      (fn []
        (for-each (fn [entry]
          (let [{key value} entry] (set! key value))) bindings)
        (f)))))
